# ────────────────────────────────────────────────────────────────
# ASH DIARY — environment template
#
# These are read at BUILD time (static export — no server at
# runtime), so for the GitHub Actions APK build they must be set as
# a repo secret or variable and passed into the build step's `env:`
# block. See README.md → "Cloud backup setup".
#
# Copy this file to `.env.local` for local `npm run dev` too.
# Never commit real values.
# ────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
